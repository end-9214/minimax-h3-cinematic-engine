# Copy this file to .env and replace placeholders with your own values:
# cp .env.example .env

# Your deployed Modal endpoint URL (from 'modal deploy modal_app.py' output):
MINIMAX_H3_ENDPOINT="https://YOUR_MODAL_WORKSPACE--minimax-h3-cinematic-engine-generate-shot.us-east.modal.run"

# Modal domain identifier for CDN artifact downloads:
MODAL_APP_DOMAIN="YOUR_MODAL_WORKSPACE--minimax-h3-cinematic-engine"

# Modal persistent volumes:
MODELS_VOLUME_NAME="magicroll-h3-models"
OUTPUTS_VOLUME_NAME="minimax-h3-engine-outputs"
